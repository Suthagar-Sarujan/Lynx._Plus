# ---- MySQL ----
DATABASE_URL="mysql://lynx:lynx@localhost:3306/lynx_news"

# ---- Redis (BullMQ queue for scheduled publishing) ----
REDIS_URL="redis://localhost:6379"

# ---- Meta Graph API (Facebook Page + Instagram Business account) ----
# Create a Facebook App at developers.facebook.com, generate a long-lived
# Page access token, and link an Instagram Business/Creator account to that
# Page inside Meta Business Suite before filling these in.
META_GRAPH_API_VERSION="v21.0"
META_PAGE_ID="your-facebook-page-id"
META_PAGE_ACCESS_TOKEN="your-long-lived-page-access-token"
META_IG_USER_ID="your-linked-instagram-business-account-id"

# ---- Translation ----
# Self-hosted LibreTranslate instance (open source). Point this at your own
# deployment, e.g. http://localhost:5000, or a hosted LibreTranslate mirror.
LIBRETRANSLATE_URL="http://localhost:5000"
LIBRETRANSLATE_API_KEY=""

# ---- App ----
PUBLIC_BASE_URL="http://localhost:3000"

# ---- Login (single admin) ----
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
AUTH_SECRET="generate-a-random-string-of-32+-characters"

# ---- Autopilot ----
# How often the worker imports news and considers queueing a story (minutes).
AUTOPILOT_TICK_MINUTES="30"
# Slack/Discord-style incoming webhook that receives failure + expired-token alerts (optional).
ALERT_WEBHOOK_URL=""

# ---- Token renewal (npm run meta:connect / POST /api/meta/token) ----
# From developers.facebook.com > your app > Settings > Basic. Keep the secret private.
META_APP_ID=""
META_APP_SECRET=""
