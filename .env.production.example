# Copy to .env.production on the server and fill in. Never commit the real file.

# ---- Public address (free: yourname.duckdns.org) ----
DOMAIN=yourname.duckdns.org

# ---- Database (choose long random passwords; they are only used inside Docker) ----
MYSQL_PASSWORD=change-me-app-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# ---- Meta (Facebook + Instagram) ----
META_GRAPH_API_VERSION=v21.0
META_PAGE_ID=
META_IG_USER_ID=
# Used once to create the permanent Page token: docker compose exec web npm run meta:connect -- <token>
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# ---- Translation (optional; leave languages as "en" in the Autopilot page if unused) ----
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# ---- Login (single admin) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 32+ random characters, e.g. from: openssl rand -hex 32
AUTH_SECRET=

# ---- Autopilot ----
AUTOPILOT_TICK_MINUTES=30
# Slack/Discord incoming webhook for failure alerts (optional but recommended)
ALERT_WEBHOOK_URL=
